        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hai nến có giá cao nhất gần như ngang nhau. Tín hiệu tạo đỉnh cho thấy ngưỡng kháng cự mạnh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "兩根K線的最高價幾乎位於同一水準。顯示強大壓力的觸頂訊號。"
          }
        }
      }
    },
    "pattern.description.毛抜き底" : {
      "comment" : "ローソク足パターン「毛抜き底」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
