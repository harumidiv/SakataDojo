        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "出現向下跳空缺口後，3根黑K連創新低，接著出現十字線。顯示賣方力道後繼無力的底部訊號。"
          }
        }
      }
    },
    "pattern.description.下放れ並び赤" : {
