          }
        }
      }
    },
    "pattern.description.陽のたすき線" : {
      "comment" : "ローソク足パターン「陽のたすき線」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a bearish candle, a bullish candle opens inside its body and closes above its high. A bullish reversal sign that cancels the downward momentum at low levels."
