          }
        }
      }
    },
    "pattern.description.切り込み線" : {
      "comment" : "ローソク足パターン「切り込み線」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "After a bearish candle, a bullish candle opens lower and closes above the bearish candle’s midpoint. A rebound signal from the bottom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
