      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A candle with a long lower shadow that appears after an uptrend. A top reversal signal that shows instability at high price levels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "上昇トレンド後の下ヒゲが長い足。高値圏での不安定さを示す天井転換サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "상승 추세 후 아랫꼬리가 긴 캔들. 고가권의 불안정을 나타내는 천장 전환 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nến có bóng dưới dài, xuất hiện sau xu hướng tăng. Tín hiệu đảo chiều tại đỉnh cho thấy sự bất ổn ở vùng giá cao."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "上升趨勢後出現下影線很長的K線。顯示高檔不穩定的頂部反轉訊號。"
          }
        }
      }
    },
