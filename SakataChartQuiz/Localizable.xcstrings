          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黑K隔日，紅K自前一日實體內開盤，並收在前一日高點之上。在低檔抵銷跌勢的上漲反轉訊號。"
          }
        }
