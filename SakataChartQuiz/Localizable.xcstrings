        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "2本の安値がほぼ同じ水準で並ぶ。強いサポートの存在を示す底打ちサイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "두 캔들의 저가가 거의 같은 수준에 나란히 형성. 강한 지지의 존재를 나타내는 바닥 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
