    "pattern.description.最後の抱き線陰" : {
      "comment" : "ローソク足パターン「最後の抱き線陰」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Late in a downtrend, a large bearish candle engulfs a small bullish candle. A bullish reversal signal, with the bottom confirmed when the next day opens higher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "下降トレンド末期に、小陽線を大陰線が包む形。翌日の上寄りで底入れを確認する買い転換サイン。"
