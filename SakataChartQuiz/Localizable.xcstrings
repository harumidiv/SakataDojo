    "pattern.description.あて首線" : {
      "comment" : "ローソク足パターン「あて首線」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a downtrend, after a long bearish candle, a bullish candle opens lower and only recovers to around the prior low. A continuation signal showing a weak rebound."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下降中の大陰線の翌日、安く始まった陽線が前日の安値付近までしか戻らない形。戻りの弱さを示す下落継続サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하락 중 장대음봉 다음 날, 낮게 시작한 양봉이 전일 저가 부근까지만 회복하는 형태. 반등이 약함을 나타내는 하락 지속 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong xu hướng giảm, sau nến giảm dài, nến tăng mở cửa thấp hơn và chỉ hồi lên quanh mức thấp trước đó. Tín hiệu tiếp diễn cho thấy nhịp hồi yếu."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下跌途中長黑K隔日，低開的紅K僅回升至前一日低點附近。顯示反彈無力的下跌持續訊號。"
          }
        }
      }
    },
    "pattern.description.かぶせ線" : {
      "comment" : "ローソク足パターン「かぶせ線」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "After a bullish candle, a bearish candle opens higher and closes below the bullish candle’s midpoint. A sign of a pullback from a top."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "陽線の後、高く始まって陽線の半値以下まで食い込む陰線。天井からの反落サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "양봉 다음에 높게 시작한 음봉이 양봉의 중간값 아래까지 파고듭니다. 천장에서 하락 반전하는 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau một nến tăng, nến giảm mở cửa cao hơn rồi đóng cửa dưới điểm giữa của nến tăng. Tín hiệu giá quay đầu giảm từ đỉnh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "紅K之後，黑K開高並跌破紅K的半值以下。是從頭部回落的訊號。"
          }
        }
      }
    },
    "pattern.description.カラカサ" : {
      "comment" : "ローソク足パターン「カラカサ」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A candle with a long lower shadow after a downtrend. A reversal sign showing strong buying interest near the bottom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "下降トレンド後の下ヒゲが長い足。底値圏での強い買い意欲を示す反転サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "하락 추세 후 긴 아랫꼬리가 달린 캔들입니다. 바닥권에서 강한 매수 의지를 나타내는 반전 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nến có bóng dưới dài xuất hiện sau xu hướng giảm. Tín hiệu đảo chiều cho thấy lực mua mạnh ở vùng đáy."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "下跌趨勢後出現帶有長下影線的K線。顯示底部區域買盤強勁的反轉訊號。"
          }
        }
      }
    },
    "pattern.description.トンカチ" : {
      "comment" : "ローソク足パターン「トンカチ」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small-bodied candle with a long upper shadow after a downtrend. A bottoming signal showing that buyers are starting to step in at low prices."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下降トレンド後に出る、上ヒゲが長く実体が小さい足。安値圏で買いが入り始めたことを示す底打ちサイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하락 추세 후 나타나는 윗꼬리가 길고 몸통이 작은 캔들. 저가권에서 매수가 들어오기 시작했음을 나타내는 바닥 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nến thân nhỏ, bóng trên dài xuất hiện sau xu hướng giảm. Tín hiệu tạo đáy cho thấy lực mua bắt đầu xuất hiện ở vùng giá thấp."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下跌趨勢後出現上影線長、實體小的K線。顯示低檔開始有買盤進場的止跌訊號。"
          }
        }
      }
    },
    "pattern.description.トンボ" : {
      "comment" : "ローソク足パターン「トンボ」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A doji with only a lower shadow after a downtrend. A reversal sign showing sellers losing steam and buyers stepping in."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "下降トレンド後の下ヒゲのみの十字線。売り方の失速と買い方の出現を示す反転サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "하락 추세 후 아랫꼬리만 있는 도지입니다. 매도세의 약화와 매수세의 등장을 나타내는 반전 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Doji chỉ có bóng dưới, xuất hiện sau xu hướng giảm. Tín hiệu đảo chiều cho thấy phe bán đuối sức và phe mua bắt đầu tham gia."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "下跌趨勢後出現只有下影線的十字線。顯示賣方力竭、買方進場的反轉訊號。"
          }
        }
      }
    },
    "pattern.description.三尊" : {
      "comment" : "ローソク足パターン「三尊」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three peaks with the middle one highest. A break below the neckline is taken to confirm a top — a classic sell signal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3つの山のうち中央が最も高い形。ネックラインを割り込むと天井確定とされる代表的な売りサイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세 개의 봉우리 중 가운데가 가장 높은 형태. 넥라인을 하향 돌파하면 천장이 확정된 것으로 보는 대표적인 매도 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba đỉnh, trong đó đỉnh giữa cao nhất. Khi giá phá xuống đường viền cổ, đỉnh được xác nhận — tín hiệu bán kinh điển."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三個高點中以中間最高的型態。跌破頸線即視為頭部確立，是代表性的賣出訊號。"
          }
        }
      }
    },
    "pattern.description.三空叩き込み" : {
      "comment" : "ローソク足パターン「三空叩き込み」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three bearish candles each opening with a gap down. Signals an oversold market where panic selling has been exhausted — a bottoming sign."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窓を開けた陰線が3回続く形。売られ過ぎを示し、投げ売りが出尽くした底値サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갭을 띄운 음봉이 세 번 연속되는 형태. 과매도와 투매가 소진되었음을 나타내는 바닥 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba nến giảm liên tiếp, mỗi nến đều mở cửa với khoảng trống giảm. Cho thấy thị trường quá bán và lực bán tháo đã cạn — tín hiệu tạo đáy."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連續三次跳空下跌的黑K。顯示超賣、恐慌賣壓出盡的底部訊號。"
          }
        }
      }
    },
    "pattern.description.三空踏み上げ" : {
      "comment" : "ローソク足パターン「三空踏み上げ」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three bullish candles each opening with a gap up. Signals an overbought market where short covering has run its course — a topping sign."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窓を開けた陽線が3回続く形。買われ過ぎを示し、売り方の買い戻しが一巡した天井サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갭을 띄운 양봉이 세 번 연속되는 형태. 과매수와 매도 세력의 환매가 일단락되었음을 나타내는 천장 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba nến tăng liên tiếp, mỗi nến đều mở cửa với khoảng trống tăng. Cho thấy thị trường quá mua và lệnh mua bù đã cạn — tín hiệu tạo đỉnh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連續三次跳空上漲的紅K。顯示超買、空方回補告一段落的頭部訊號。"
          }
        }
      }
    },
    "pattern.description.三羽烏" : {
      "comment" : "ローソク足パターン「三羽烏」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Three bearish candles in a row near the highs, each closing lower than the last. A sign of a shift from an uptrend to a downtrend."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "高値圏で3本の陰線が続き、終値が順に下降。上昇から下降への転換サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "고가권에서 음봉 3개가 연속으로 나타나며 종가가 차례로 낮아집니다. 상승에서 하락으로 전환하는 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ba nến giảm liên tiếp ở vùng giá cao, mỗi nến đóng cửa thấp hơn nến trước. Tín hiệu chuyển từ xu hướng tăng sang xu hướng giảm."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在高檔區連續出現3根黑K，收盤價依序走低。由漲轉跌的轉折訊號。"
          }
        }
      }
    },
    "pattern.description.上げ三法" : {
      "comment" : "ローソク足パターン「上げ三法」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a long bullish candle, about three small candles stay within its range, then a bullish candle makes a new high. A continuation signal after a pause."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大陽線の後、その値幅内に小さな足が3本ほど続き、再び陽線が高値を更新する形。一服後の上昇継続サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장대양봉 이후 그 범위 안에서 작은 캔들이 3개 정도 이어지고, 다시 양봉이 고가를 경신하는 형태. 숨 고르기 후의 상승 지속 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau một nến tăng dài, khoảng ba nến nhỏ nằm trong biên độ của nó, rồi một nến tăng lập đỉnh mới. Tín hiệu tiếp diễn xu hướng tăng sau khi tạm nghỉ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長紅K之後，約三根小K線在其範圍內整理，接著紅K再創新高。整理後的上漲持續訊號。"
          }
        }
      }
    },
    "pattern.description.上放れタスキ" : {
      "comment" : "ローソク足パターン「上放れタスキ」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Two bullish candles after a gap up, followed by a bearish candle that fails to fill the gap. A signal that the uptrend is continuing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ギャップアップ後2本陽線、その後の陰線がギャップを埋めきれない。上昇継続サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "갭 상승 후 양봉 2개가 이어지고, 그다음 음봉이 갭을 다 메우지 못함. 상승 지속 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau khoảng trống tăng là hai nến tăng, tiếp theo là nến giảm không lấp đầy được khoảng trống. Tín hiệu xu hướng tăng tiếp diễn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "跳空上漲後出現兩根紅K，隨後的黑K未能完全回補缺口。上漲持續訊號。"
          }
        }
      }
    },
    "pattern.description.上放れの星" : {
      "comment" : "ローソク足パターン「上放れの星」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A doji (star) appears after a gap up during an uptrend. A warning that the advance may be ending and a top reversal is near."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上昇中に窓を開けて上放れた後、十字線（星）が出る形。上昇の終局を示す天井転換警戒サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상승 중 갭 상승 후 도지(별)가 나타나는 형태. 상승의 끝을 알리는 천장 반전 경고 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doji (ngôi sao) xuất hiện sau khoảng trống tăng trong xu hướng tăng. Cảnh báo đà tăng sắp kết thúc và có thể đảo chiều tại đỉnh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上漲途中向上跳空後出現十字線（星線）。暗示漲勢將盡、須提防頭部反轉的警訊。"
          }
        }
      }
    },
    "pattern.description.上放れ三手放れ寄せ線" : {
      "comment" : "ローソク足パターン「上放れ三手放れ寄せ線」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "After a gap up, three bullish candles make new highs, followed by a doji. A top sign showing buying pressure running out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "上方へ窓を空けた後、3本の陽線が高値を更新し、十字線が出現。買い勢力の行き詰まりを示す天井サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "위쪽으로 갭이 생긴 후 양봉 3개가 고가를 경신하고 도지가 나타납니다. 매수세가 한계에 다다랐음을 나타내는 천장 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau khoảng trống tăng, ba nến tăng liên tục tạo mức giá cao mới rồi xuất hiện doji. Tín hiệu đỉnh cho thấy lực mua đã cạn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "出現向上跳空缺口後，3根紅K連創新高，接著出現十字線。顯示買方力道後繼無力的頭部訊號。"
          }
        }
      }
    },
    "pattern.description.上放れ並び赤" : {
      "comment" : "ローソク足パターン「上放れ並び赤」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "After a gap up, two bullish candles of the same size appear side by side. A sign that strong buying momentum is continuing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ギャップアップ後に同じ大きさの陽線が2本並ぶ。強い買い勢いの継続サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "갭 상승 후 같은 크기의 양봉 2개가 나란히 나타납니다. 강한 매수세가 이어지는 지속 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau khoảng trống tăng, hai nến tăng có kích thước tương đương nằm cạnh nhau. Tín hiệu đà mua mạnh đang tiếp diễn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "向上跳空缺口後，出現2根大小相同的紅K並列。強勁買氣持續的訊號。"
          }
        }
      }
    },
    "pattern.description.上放れ並び黒" : {
      "comment" : "ローソク足パターン「上放れ並び黒」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "During an uptrend, two similar bearish candles appear side by side after a gap up. It may signal the uptrend resuming after a pullback, but it’s a weak sign that needs confirmation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "上昇途中のギャップアップ後に同程度の陰線が2本並ぶ。押し目からの上昇継続候補だが、確認を要する弱いサイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "상승 도중 갭 상승 후 비슷한 크기의 음봉 2개가 나란히 나타납니다. 눌림목 이후 상승이 이어질 수 있지만, 확인이 필요한 약한 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trong xu hướng tăng, sau khoảng trống tăng xuất hiện hai nến giảm có kích thước tương tự nằm cạnh nhau. Có thể báo hiệu đà tăng tiếp diễn sau nhịp điều chỉnh, nhưng đây là tín hiệu yếu cần xác nhận thêm."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "上漲途中出現向上跳空缺口後，2根大小相近的黑K並列。可能是回檔後續漲的跡象，但屬於需要確認的弱勢訊號。"
          }
        }
      }
    },
    "pattern.description.下げ三法" : {
      "comment" : "ローソク足パターン「下げ三法」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a long bearish candle, about three small candles stay within its range, then a bearish candle makes a new low. A continuation signal after a pause."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大陰線の後、その値幅内に小さな足が3本ほど続き、再び陰線が安値を更新する形。一服後の下落継続サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장대음봉 이후 그 범위 안에서 작은 캔들이 3개 정도 이어지고, 다시 음봉이 저가를 경신하는 형태. 숨 고르기 후의 하락 지속 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau một nến giảm dài, khoảng ba nến nhỏ nằm trong biên độ của nó, rồi một nến giảm lập đáy mới. Tín hiệu tiếp diễn xu hướng giảm sau khi tạm nghỉ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長黑K之後，約三根小K線在其範圍內整理，接著黑K再創新低。整理後的下跌持續訊號。"
          }
        }
      }
    },
    "pattern.description.下放れタスキ" : {
      "comment" : "ローソク足パターン「下放れタスキ」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Two bearish candles after a gap down, followed by a bullish candle that fails to fill the gap. A signal that the downtrend is continuing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ギャップダウン後2本陰線、その後の陽線がギャップを埋めきれない。下落継続サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "갭 하락 후 음봉 2개가 이어지고, 그다음 양봉이 갭을 다 메우지 못함. 하락 지속 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau khoảng trống giảm là hai nến giảm, tiếp theo là nến tăng không lấp đầy được khoảng trống. Tín hiệu xu hướng giảm tiếp diễn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "跳空下跌後出現兩根黑K，隨後的紅K未能完全回補缺口。下跌持續訊號。"
          }
        }
      }
    },
    "pattern.description.下放れの星" : {
      "comment" : "ローソク足パターン「下放れの星」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A doji (star) appears after a gap down during a downtrend. A sign that the decline may be ending and a bottom reversal is near."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下降中に窓を開けて下放れた後、十字線（星）が出る形。下落の終局を示す底値転換警戒サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하락 중 갭 하락 후 도지(별)가 나타나는 형태. 하락의 끝을 알리는 바닥 반전 경고 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doji (ngôi sao) xuất hiện sau khoảng trống giảm trong xu hướng giảm. Dấu hiệu đà giảm sắp kết thúc và có thể đảo chiều tại đáy."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下跌途中向下跳空後出現十字線（星線）。暗示跌勢將盡、可留意底部反轉的訊號。"
          }
        }
      }
    },
    "pattern.description.下放れ三手放れ寄せ線" : {
