    "pattern.description.宵の明星" : {
      "comment" : "ローソク足パターン「宵の明星」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Three candles: a large bullish candle, a small real body, and a large bearish candle. A bearish reversal signal from a top."
          }
