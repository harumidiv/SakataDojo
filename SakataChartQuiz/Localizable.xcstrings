        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nến giảm lớn bao trùm hoàn toàn nến tăng của phiên trước. Tín hiệu đảo chiều giảm do áp lực bán mạnh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
