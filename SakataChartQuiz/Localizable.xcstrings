      }
    },
    "pattern.description.差し込み線" : {
      "comment" : "ローソク足パターン「差し込み線」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a downtrend, after a long bearish candle, a bullish candle opens lower and pushes into the prior body but stays below its midpoint. A continuation signal where rallies are sold."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下降中の大陰線の翌日、安く始まった陽線が前日の実体に食い込むが半値まで届かない形。戻り売りを示す下落継続サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하락 중 장대음봉 다음 날, 낮게 시작한 양봉이 전일 몸통 안으로 파고들지만 절반까지는 미치지 못하는 형태. 반등 시 매도가 나오는 하락 지속 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong xu hướng giảm, sau nến giảm dài, nến tăng mở cửa thấp hơn và đâm vào thân nến trước nhưng chưa tới nửa thân. Tín hiệu tiếp diễn khi nhịp hồi bị bán ra."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下跌途中長黑K隔日，低開的紅K切入前一日實體，但未達一半。顯示反彈遭賣壓的下跌持續訊號。"
          }
        }
      }
    },
    "pattern.description.明けの明星" : {
      "comment" : "ローソク足パターン「明けの明星」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Three candles: a large bearish candle, a small real body, and a large bullish candle. A bullish reversal signal after bottoming out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "大陰線・小実体・大陽線の3本。底打ちからの上昇転換サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "큰 음봉, 작은 몸통, 큰 양봉의 3개 캔들. 바닥을 찍은 후의 상승 전환 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gồm 3 nến: nến giảm lớn, nến thân nhỏ và nến tăng lớn. Tín hiệu đảo chiều tăng sau khi chạm đáy."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "由大黑K、小實體、大紅K三根K線組成。觸底後轉為上漲的反轉訊號。"
          }
        }
      }
    },
    "pattern.description.毛抜き天井" : {
      "comment" : "ローソク足パターン「毛抜き天井」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Two candles with highs at nearly the same level. A topping signal that shows strong resistance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "2本の高値がほぼ同じ水準で並ぶ。強いレジスタンスを示す天井打ちサイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "두 캔들의 고가가 거의 같은 수준에 나란히 형성. 강한 저항을 나타내는 천장 신호."
          }
