        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuối xu hướng giảm, nến giảm lớn bao trùm nến tăng nhỏ. Tín hiệu đảo chiều tăng, đáy được xác nhận khi phiên sau mở cửa cao hơn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "下跌趨勢末段，大黑K吞噬小紅K的型態。隔日開高即確認底部，為買進反轉訊號。"
          }
        }
      }
    },
    "pattern.description.最後の抱き線陽" : {
