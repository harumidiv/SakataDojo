    "pattern.description.入り首線" : {
      "comment" : "ローソク足パターン「入り首線」の説明文",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a downtrend, after a long bearish candle, a bullish candle opens lower and closes only slightly above the prior close. A continuation signal showing a weak rebound."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下降中の大陰線の翌日、安く始まった陽線が前日の終値をわずかに上回るだけで終わる形。戻りの弱さを示す下落継続サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하락 중 장대음봉 다음 날, 낮게 시작한 양봉이 전일 종가를 약간 웃도는 데 그치는 형태. 반등이 약함을 나타내는 하락 지속 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong xu hướng giảm, sau nến giảm dài, nến tăng mở cửa thấp hơn và chỉ đóng cửa nhỉnh hơn giá đóng cửa trước đó. Tín hiệu tiếp diễn cho thấy nhịp hồi yếu."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下跌途中長黑K隔日，低開的紅K僅略高於前一日收盤價。顯示反彈無力的下跌持續訊號。"
          }
        }
      }
    },
    "pattern.description.最後の抱き陰線" : {
      "comment" : "ローソク足パターン「最後の抱き陰線」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Late in a downtrend, a large bearish candle engulfs a small bullish candle. A bullish reversal signal, with the bottom confirmed when the next day opens higher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "下降トレンド末期に、小陽線を大陰線が包む形。翌日の上寄りで底入れを確認する買い転換サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "하락 추세 막바지에 큰 음봉이 작은 양봉을 감싸는 형태. 다음 날 시가가 높게 형성되면 바닥이 확인되는 매수 전환 신호."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuối xu hướng giảm, nến giảm lớn bao trùm nến tăng nhỏ. Tín hiệu đảo chiều tăng, đáy được xác nhận khi phiên sau mở cửa cao hơn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "下跌趨勢末段，大黑K吞噬小紅K的型態。隔日開高即確認底部，為買進反轉訊號。"
          }
        }
      }
    },
    "pattern.description.最後の抱き陽線" : {
      "comment" : "ローソク足パターン「最後の抱き陽線」の説明文",
      "extractionState" : "extracted_with_value",
