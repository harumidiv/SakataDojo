    "pattern.description.かぶせ線" : {
      "comment" : "ローソク足パターン「かぶせ線」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "After a bullish candle, a bearish candle opens higher and closes below the bullish candle’s midpoint. A sign of a pullback from a top."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "陽線の後、高く始まって陽線の半値以下まで食い込む陰線。天井からの反落サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "양봉 다음에 높게 시작한 음봉이 양봉의 중간값 아래까지 파고듭니다. 천장에서 하락 반전하는 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sau một nến tăng, nến giảm mở cửa cao hơn rồi đóng cửa dưới điểm giữa của nến tăng. Tín hiệu giá quay đầu giảm từ đỉnh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "紅K之後，黑K開高並跌破紅K的半值以下。是從頭部回落的訊號。"
          }
        }
      }
    },
    "pattern.description.はらみ足陰線" : {
      "comment" : "ローソク足パターン「はらみ足陰線」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A small bearish candle sits within the real body of a large bullish candle. A reversal sign showing weakening buying pressure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "大陽線の実体内に小陰線が収まる。買い勢力の弱まりを示す反転サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "큰 양봉의 몸통 안에 작은 음봉이 들어갑니다. 매수세가 약해졌음을 나타내는 반전 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Một nến giảm nhỏ nằm gọn trong thân nến của một nến tăng lớn. Tín hiệu đảo chiều cho thấy lực mua đang suy yếu."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "小黑K落在長紅K的實體之內。顯示買方力道減弱的反轉訊號。"
          }
        }
      }
    },
    "pattern.description.はらみ足陽線" : {
      "comment" : "ローソク足パターン「はらみ足陽線」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A small bullish candle sits within the real body of a large bearish candle. A reversal sign showing weakening selling pressure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "大陰線の実体内に小陽線が収まる。売り勢力の弱まりを示す反転サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "큰 음봉의 몸통 안에 작은 양봉이 들어갑니다. 매도세가 약해졌음을 나타내는 반전 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Một nến tăng nhỏ nằm gọn trong thân nến của một nến giảm lớn. Tín hiệu đảo chiều cho thấy lực bán đang suy yếu."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "小紅K落在長黑K的實體之內。顯示賣方力道減弱的反轉訊號。"
          }
        }
      }
    },
    "pattern.description.カラカサ" : {
      "comment" : "ローソク足パターン「カラカサ」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A candle with a long lower shadow after a downtrend. A reversal sign showing strong buying interest near the bottom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "下降トレンド後の下ヒゲが長い足。底値圏での強い買い意欲を示す反転サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "하락 추세 후 긴 아랫꼬리가 달린 캔들입니다. 바닥권에서 강한 매수 의지를 나타내는 반전 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nến có bóng dưới dài xuất hiện sau xu hướng giảm. Tín hiệu đảo chiều cho thấy lực mua mạnh ở vùng đáy."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "下跌趨勢後出現帶有長下影線的K線。顯示底部區域買盤強勁的反轉訊號。"
          }
        }
      }
    },
    "pattern.description.トンカチ" : {
      "comment" : "ローソク足パターン「トンカチ」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A candle with a long upper shadow after an uptrend. A top reversal sign where selling pushed the price back down from its highs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "上昇トレンド後の上ヒゲが長い足。高値で売りに押された天井転換サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "상승 추세 후 긴 윗꼬리가 달린 캔들입니다. 고가에서 매도에 밀린 천장 반전 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nến có bóng trên dài xuất hiện sau xu hướng tăng. Tín hiệu đảo chiều tại đỉnh khi lực bán đẩy giá xuống từ vùng giá cao."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "上漲趨勢後出現帶有長上影線的K線。在高點遭賣壓打回的頭部反轉訊號。"
          }
        }
      }
    },
    "pattern.description.トンボ" : {
      "comment" : "ローソク足パターン「トンボ」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A doji with only a lower shadow after a downtrend. A reversal sign showing sellers losing steam and buyers stepping in."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "下降トレンド後の下ヒゲのみの十字線。売り方の失速と買い方の出現を示す反転サイン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "하락 추세 후 아랫꼬리만 있는 도지입니다. 매도세의 약화와 매수세의 등장을 나타내는 반전 신호입니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Doji chỉ có bóng dưới, xuất hiện sau xu hướng giảm. Tín hiệu đảo chiều cho thấy phe bán đuối sức và phe mua bắt đầu tham gia."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "下跌趨勢後出現只有下影線的十字線。顯示賣方力竭、買方進場的反轉訊號。"
          }
        }
      }
    },
    "pattern.description.三羽烏" : {
      "comment" : "ローソク足パターン「三羽烏」の説明文",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Three bearish candles in a row near the highs, each closing lower than the last. A sign of a shift from an uptrend to a downtrend."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
